# =============================================================================
# FaceChain 2.0 — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_NAME=FaceChain 2.0
DEBUG=false

# --- Face Detection ---
INSIGHTFACE_MODEL=buffalo_l
MIN_FACE_CONFIDENCE=0.5

# --- Search Provider ---
# Options: "serpapi" (live Google Lens), "facecheck" (live API), or "mock" (cached fallback)
SEARCH_PROVIDER=serpapi
# SerpApi key — free tier: 100 searches/month, no credit card
# Sign up at https://serpapi.com
SERPAPI_API_KEY=
FACECHECK_API_TOKEN=
# Set to true for free/testing searches (inaccurate results, no credits used)
FACECHECK_TESTING_MODE=true
AUTO_SELECT_THRESHOLD=70

# --- Blockchain (Polygon Amoy Testnet) ---
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
# Private key of the deployer wallet (NO 0x prefix)
DEPLOYER_PRIVATE_KEY=your_wallet_private_key_no_0x_prefix
# Address of the deployed EvidenceRegistry contract
CONTRACT_ADDRESS=0xYourDeployedContractAddress

# --- IPFS / Pinata (Optional) ---
PINATA_JWT=your_pinata_jwt_optional
IPFS_ENABLED=false

# --- Database ---
DATABASE_URL=sqlite:///./data/facechain.db
